# Example environment for compose.yaml and compose.external.yaml.
#
# Copy to `.env` (git-ignored) and adjust, or pass it with `--env-file`. This file contains NO real secrets:
# every credential below is intentionally empty and must be provided by the
# operator at deployment time.

# --- Shared ---------------------------------------------------------------
# Image produced by `scripts/package-oci.sh` (or a pinned digest you trust).
HODEI_IMAGE=localhost/hodei-artifacts-api:latest
# Host interface and port published by the API (loopback by default).
HODEI_BIND_ADDR=127.0.0.1
HODEI_PORT=3000
HODEI_SERVER__REQUEST_TIMEOUT_SECS=30
HODEI_SERVER__MAX_BODY_SIZE=10485760
HODEI_LOGGING__LEVEL=info
HODEI_LOGGING__FORMAT=json
HODEI_SECURITY__ADMIN_API_ENABLED=false
HODEI_SECURITY__RAW_API_ENABLED=false
HODEI_SECURITY__OCI_API_ENABLED=false

# --- Signing key of the Terraform mirror (both compose files) ---------------
# Path to a file with the secret that signs the short-lived archive URLs of the
# provider mirror. Required, no default. Generate it yourself and keep it out of
# the repository:  openssl rand -hex 32 > signing-key && chmod 0444 signing-key
# (the container user, UID 10001, must be able to read it). Rotation: see
# docs/community/configuration.md, section [signing].
HODEI_SIGNING_KEY_FILE=
HODEI_SIGNING_KEY_ID=primary

# --- Standalone (compose.yaml) --------------------------------------------
# Embedded RocksDB + filesystem CAS in the `hodei-artifacts-data` volume.
# Single writer: never run more than one replica against the same volume.
RUN_MODE=standalone

# --- External (compose.external.yaml): Dgraph + S3-compatible storage -------
DGRAPH_IMAGE=docker.io/dgraph/dgraph:v25.5.1@sha256:f7459f391921c94db78f8205de9b4624210e2396c6b4ef5736838a906a38becb
GARAGE_IMAGE=docker.io/dxflrs/garage:v1.0.1
DGRAPH_ALPHA_HTTP_PORT=8080
DGRAPH_ALPHA_GRPC_PORT=9080
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
HODEI_CONTENT__S3__BUCKET=hodei-content
HODEI_CONTENT__S3__ENDPOINT=garage:3900
HODEI_CONTENT__S3__REGION=garage
HODEI_CONTENT__S3__TLS=false
# Required, no defaults. Generate them yourself, e.g. `openssl rand -hex 32`.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# S3 access key created in Garage (`garage key create`); never commit values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
